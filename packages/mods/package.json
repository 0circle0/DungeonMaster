{
  "name": "@dm/mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mod format and sandbox: manifests, content hashing, resolution, and the QuickJS host. Knows nothing about GameState \u2014 everything crosses the sandbox boundary as JSON.",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./load": {
      "types": "./src/load.ts",
      "import": "./src/load.ts",
      "default": "./src/load.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "dependencies": {
    "@dm/core": "0.1.0",
    "@dm/module": "0.1.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^3.24.1"
  },
  "types": "./src/index.ts"
}
