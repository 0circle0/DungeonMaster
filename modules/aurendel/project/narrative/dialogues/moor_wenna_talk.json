    {
      "id": "greet",
      "says": [
        {
          "text": "A cottage with a peat stack under the eave twice the size of the cottage, and a woman counting it who does not need to."
        },
        {
          "text": "“It is my turn this fortnight. Talk while I carry.”"
        }
      ],
      "onEnter": [],
