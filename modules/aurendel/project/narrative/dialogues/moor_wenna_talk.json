    {
      "id": "moor_wenna_years_told",
      "says": [
        {
          "text": "“Two hundred years and a bit.” Wenna says it the way you say your own age. “Colder kept it forty. The parish has kept it since, on the rota, and there is no gap in the rota — I have been through it twice looking for one.” A dry look. “Every parish record in Aurendel has a gap in it. Ours does not.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "moor_fire_years"
          }
        }
      ],
      "options": [
        {
          "id": "moor_wenna_years_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "moor_wenna_years_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_library",
            "amount": -1
          }
        }
      ],
      "options": [
        {
          "id": "moor_wenna_years_drop",
          "text": "Leave it.",
          "goto": "greet",
