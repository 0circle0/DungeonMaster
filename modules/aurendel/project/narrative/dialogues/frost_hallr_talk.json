    {
      "id": "frost_hallr_making_told",
      "says": [
        {
          "text": "He turns the log round rather than reading it to you. The column is forty years deep and there are gaps in it, and the gaps are every thaw. “It does not keep to a season. It keeps to the ice.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "frost_blue_making"
          }
        }
      ],
      "options": [
        {
          "id": "frost_hallr_making_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_hallr_making_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
