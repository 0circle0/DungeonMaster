    {
      "id": "greet",
      "says": [
        {
          "text": "A hut with one window facing the calving face and a log open on the sill. He puts his body between you and it without appearing to."
        },
        {
          "text": "“Rimewatch. I keep it for the moot.” A pause exactly long enough to be rude. “Not for the Landing, and not for you.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "frost_hallr_down",
          "text": "The marker on the Glass Ice. What is it pointing at?",
          "requires": {
            "without": {
              "lore": [
                "frost_marker_down"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
