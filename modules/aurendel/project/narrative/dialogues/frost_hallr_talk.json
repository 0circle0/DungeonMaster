      ],
      "redirectWhen": []
    },
    {
      "id": "frost_hallr_stone_kept",
      "says": [
        {
          "text": "“It is the moot's,” he says, and does not elaborate, and does not move his hand."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_ice_moot",
            "amount": -3
          }
        }
      ],
      "options": [
        {
          "id": "frost_hallr_stone_leave",
