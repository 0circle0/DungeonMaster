    {
      "id": "frost_hallr_down_told",
      "says": [
        {
          "text": "“Nothing. That is the trouble with it.” He shifts, and decides to say the rest. “Every marker on the Reach points at a cairn. That one points at open ice. Stand where the cutter stood, though — properly, with your eye where his was — and it is not pointing across at all.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "frost_marker_down"
          }
        }
      ],
      "options": [
        {
          "id": "frost_hallr_down_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_hallr_down_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_ice_moot",
            "amount": -1
          }
