    {
      "id": "thorn_maud_bill_gave",
      "says": [
        {
          "text": "She hands it over haft first, which is how you hand somebody a bill if you have any sense. “It came with the cottage. Mind the hook, it comes back at you.”"
        }
      ],
      "onEnter": [
        {
          "grantItem": {
