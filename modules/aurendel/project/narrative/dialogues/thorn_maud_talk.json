    {
      "id": "thorn_maud_rows_told",
      "says": [
        {
          "text": "“They are.” She keeps bundling. “Knees come up where the roots run, and roots do not run straight. I have cut reed in this marsh for thirty years and I have never worked that stretch, and neither did my mother, and she gave a reason once and would not give it twice.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "thorn_knees_rows"
          }
        }
      ],
      "options": [
        {
          "id": "thorn_maud_rows_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "thorn_maud_rows_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_ferrymen",
            "amount": -1
          }
        }
      ],
      "options": [
        {
          "id": "thorn_maud_rows_drop",
          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "thorn_maud_cut_told",
      "says": [
        {
          "text": "She stops. “You have seen the healed ones.” She holds up the bill. “This is the only edge in Thornmere that takes a knee off level, and this edge is a hundred years older than the handle, and I did not make either.” A shrug that is not casual. “The cuts out there are forty years healed. I was six.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "thorn_knees_cut"
          }
        }
      ],
      "options": [
        {
          "id": "thorn_maud_cut_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "thorn_maud_cut_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
