  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Water to the thigh, a hooked bill going through reed like it is not there, and a stack of bundles behind her taller than she is."
        },
        {
          "text": "“Bundles are sold. Talk if you want, I am not stopping.”"
        }
      ],
