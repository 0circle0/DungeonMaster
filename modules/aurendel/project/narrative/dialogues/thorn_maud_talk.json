            "value": true
          }
        }
      ],
      "options": [
        {
          "id": "thorn_maud_bill_thanks",
          "text": "Thank you.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "thorn_maud_bill_kept",
      "says": [
        {
          "text": "“It is how I eat,” she says. “Buy a new one at Bel's and see how it does on a knee.”"
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_ferrymen",
            "amount": -2
          }
        }
      ],
