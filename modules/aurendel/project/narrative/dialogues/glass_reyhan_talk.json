    {
      "id": "greet",
      "says": [
        {
          "text": "A salt market at the hot end of the day, which means one stall open and everybody else asleep under it."
        },
        {
          "text": "“Coarse or fine. If you want the fine you are two months early.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "glass_reyhan_eight",
          "text": "How many courses do you cut?",
