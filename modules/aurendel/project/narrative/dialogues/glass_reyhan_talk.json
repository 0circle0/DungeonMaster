    {
      "id": "glass_reyhan_eight_told",
      "says": [
        {
          "text": "“Eight.” She says it the way you answer a question about which way is up. “Eight is what one season of sun will draw. Every pan on this coast is cut in eight, ask anyone, ask my mother if you can wake her.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "glass_courses_eight"
          }
        }
      ],
      "options": [
        {
          "id": "glass_reyhan_eight_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "glass_reyhan_eight_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
