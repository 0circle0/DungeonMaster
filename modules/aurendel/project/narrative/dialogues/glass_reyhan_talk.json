    {
      "id": "glass_reyhan_taste_told",
      "says": [
        {
          "text": "Her face closes slightly. “That is the ninth, and it is not ours, and I will thank you not to say I said so.” A pause. “It is heavier. And it does not taste of this sea, and I have licked my fingers in these pans since I was four.”"
        }
      ],
