    },
    {
      "id": "moor_ferrin_green_told",
      "says": [
        {
          "text": "“Every night of my life.” Ferrin does not think it worth remarking on until he does. “Twice a year it goes green. I can see it go from this door, eleven mile off, and the lamps in the village all come on inside the same quarter hour and then they all go out.” He sets the cup down. “Nobody rings anything. They just go in.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "moor_fire_green"
          }
        }
      ],
      "options": [
        {
          "id": "moor_ferrin_green_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
