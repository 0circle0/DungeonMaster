      "redirectWhen": []
    },
    {
      "id": "moor_ferrin_map_kept",
      "says": [
        {
          "text": "“It is the only thing in here worth anything,” Ferrin says, “and I am not sentimental about much,” and rolls it up."
        }
      ],
