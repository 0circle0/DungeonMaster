            "value": true
          }
        }
      ],
      "options": [
        {
          "id": "moor_ferrin_map_thanks",
          "text": "Thank you.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
