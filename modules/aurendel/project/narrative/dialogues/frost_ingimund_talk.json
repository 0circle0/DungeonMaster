            "onFailure": "frost_ingimund_count_wont"
          }
        },
        {
          "id": "greet_leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
