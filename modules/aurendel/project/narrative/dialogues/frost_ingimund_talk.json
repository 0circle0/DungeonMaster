{
  "id": "frost_ingimund_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Ledgers to the ceiling and a very small stove. He has the look of a man who has priced you already."
        },
        {
          "text": "“Oil is up. Bone is down. If it is neither of those, be brief.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "frost_ingimund_moved",
          "text": "Why was the Landing moved?",
          "requires": {
            "without": {
              "lore": [
                "frost_blue_moved"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
