    {
      "id": "frost_ingimund_moved_told",
      "says": [
        {
          "text": "He does not go and fetch the book; he knows the page. “One winter, the whole station, a mile out to here. Eleven buildings.” He taps the desk once. “There is a cost for the move and a cost for the timber and a cost for the men. There is no *reason*. I have kept these ledgers for thirty years and it is the only entry in them with no reason.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "frost_blue_moved"
          }
        }
      ],
      "options": [
        {
          "id": "frost_ingimund_moved_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_ingimund_moved_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
