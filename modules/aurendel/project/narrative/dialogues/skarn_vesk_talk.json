    {
      "id": "skarn_vesk_cycle_told",
      "says": [
        {
          "text": "“Breathes.” Vesk says it like a fact about a road, which to Vesk it is. “In, then out, and you can keep the count on a watch. I have. Same count in a gale, same count in a dead calm.” A look up at the face. “Weather does not keep time. That keeps time.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "skarn_wind_cycle"
          }
        }
      ],
      "options": [
        {
          "id": "skarn_vesk_cycle_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "skarn_vesk_cycle_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "karn_dolur",
            "amount": -1
          }
        }
      ],
      "options": [
