      "id": "greet",
      "says": [
        {
          "text": "A forge in a casemate, with a fort's worth of guns outside it and no garrison to fire them."
        },
        {
          "text": "“Iron work, and I will not do locks. Ask at Blackrigging for locks.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
