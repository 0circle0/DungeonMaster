    {
      "id": "isle_othe_iron_told",
      "says": [
        {
          "text": "“Iron.” He puts down the hammer, because this is his subject. “Nobody was iron-fastening hulls when she is supposed to have gone down. Either she is a hundred years younger than the story or somebody was iron-fastening a hundred years before anybody else, and I would like to know which.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "isle_marker_iron"
          }
        }
      ],
      "options": [
        {
          "id": "isle_othe_iron_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "isle_othe_iron_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_salvors",
            "amount": -1
