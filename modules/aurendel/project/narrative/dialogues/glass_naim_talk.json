    {
      "id": "greet",
      "says": [
        {
          "text": "A hall of wheels and grit and very good light, and one bench at the back with a cloth over it."
        },
        {
          "text": "“Spectacles are the third door. Lenses for instruments, I will want to know the instrument.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "glass_naim_lens",
          "text": "The Hall grinds a lens it does not sell.",
          "requires": {
            "without": {
              "lore": [
                "glass_bath_lens"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
