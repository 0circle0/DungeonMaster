    {
      "id": "dusk_dunn_three_told",
      "says": [
        {
          "text": "“Every trip.” Dunn wipes the hub. “Three of them are not on the road. They are off it — twenty yards, forty, sixty. I used to think they had shifted the road round them.” He straightens. “Then I stood at one and sighted the other two and they line up with each other, and the line they make goes across the road, not along it.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "dusk_miles_three"
          }
        }
      ],
      "options": [
        {
          "id": "dusk_dunn_three_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "dusk_dunn_three_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
