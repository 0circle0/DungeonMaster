{
  "id": "thorn_gost_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Trays of dark water under reed shade, and a man moving them out of the sun with a hooked pole."
        },
        {
          "text": "“Leeches. Temples buy them. If you are squeamish, stand upwind.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "thorn_gost_quiet",
          "text": "Where in this marsh will leeches not live?",
          "requires": {
            "without": {
              "lore": [
                "thorn_knees_quiet"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_ferrymen",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "thorn_gost_quiet_told",
            "onFailure": "thorn_gost_quiet_wont"
          }
        },
        {
          "id": "thorn_gost_warm",
          "text": "The channels out by the hummocks run warm.",
          "requires": {
            "without": {
              "lore": [
                "thorn_hermit_warm"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
