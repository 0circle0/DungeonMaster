                      "div": [
                        {
                          "ref": "reputation.the_keepers",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "isle_ilva_pointing_told",
            "onFailure": "isle_ilva_pointing_wont"
          }
        },
        {
          "id": "isle_ilva_year",
          "text": "When did the terns come off the cut?",
          "requires": {
            "without": {
              "lore": [
                "isle_terns_year"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
