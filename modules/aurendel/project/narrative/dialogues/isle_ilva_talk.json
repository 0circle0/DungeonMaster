{
  "id": "isle_ilva_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A chapel cut into rock, with more graves outside it than Cormorant has ever had living people."
        },
        {
          "text": "“I bury what the sea gives back,” she says. “It gives back a great deal. Sit down.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "isle_ilva_pointing",
          "text": "The deep wreck's guns. Which way are they run out?",
          "requires": {
            "without": {
              "lore": [
                "isle_wreck_pointing"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                13,
                {
                  "clamp": [
