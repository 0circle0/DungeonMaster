      "redirectWhen": []
    },
    {
      "id": "step_serel_wrong_told",
      "says": [
        {
          "text": "“It is for breaking the wind.” Serel says it the way you say the thing everybody says. Then, because you have not gone away: “The wind is off the south-west. Has been since before the Lines. And the trees run south-west to north-east.” A hand, flat, drawing it in the air. “They run *with* it. Eleven miles of doing nothing at all.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "step_line_wrong"
          }
        }
      ],
      "options": [
        {
          "id": "step_serel_wrong_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "step_serel_wrong_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_horse_lords",
            "amount": -1
          }
        }
      ],
      "options": [
        {
          "id": "step_serel_wrong_drop",
          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
