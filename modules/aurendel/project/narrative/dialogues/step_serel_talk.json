{
  "id": "step_serel_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A yard of hurdles and tallies and a man going down a column with his thumb, twice, and then a third time."
        },
        {
          "text": "“I am counting. You can talk while I count.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "step_serel_wrong",
          "text": "The line of trees. What is it for?",
