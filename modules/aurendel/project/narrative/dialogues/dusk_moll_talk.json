{
  "id": "dusk_moll_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A covered burn the size of a cottage giving off no visible smoke at all, which took forty years to learn, and a woman watching it."
        },
        {
          "text": "“Do not stand upwind and do not touch the sides.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "dusk_moll_ages",
          "text": "The trees along the Greenway.",
          "requires": {
            "without": {
              "lore": [
                "dusk_green_ages"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_keepers",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "dusk_moll_ages_told",
            "onFailure": "dusk_moll_ages_wont"
          }
        },
        {
