      "id": "greet",
      "says": [
        {
          "text": "A field gate being mended by somebody who has mended it many times and expects to again."
        },
        {
          "text": "“Ford's eleven inches. Do not let the horse drink and walk at the same time.”"
        }
      ],
      "onEnter": [],
      "options": [
