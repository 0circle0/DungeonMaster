    {
      "id": "thorn_orin_none_told",
      "says": [
        {
          "text": "“There is a hut,” she says, and stops, and starts again. “I know every cutter, thatcher and leech-man between here and Stiltmarket by name. I have known them since they were children.” She puts the cloth down. “There is a fire pit out there that has been used, and I cannot name who uses it, and that has never once been true of anybody else.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "thorn_hermit_none"
          }
        }
      ],
      "options": [
        {
          "id": "thorn_orin_none_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "thorn_orin_none_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_ferrymen",
            "amount": -1
          }
        }
      ],
      "options": [
        {
