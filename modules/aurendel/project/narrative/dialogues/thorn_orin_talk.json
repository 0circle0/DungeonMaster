        }
      ],
      "redirectWhen": []
    },
    {
      "id": "thorn_orin_abandoned_told",
      "says": [
        {
          "text": "“Shut two hundred years. The Crown gave it up when the road sank — you cannot toll a road that is under water half the time.” She refills something. “Ask Sarl about the ledger, though. Ask him twice.”"
        }
      ],
      "onEnter": [
