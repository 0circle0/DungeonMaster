  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A low taproom smelling of wet reed, and a landlady who has already worked out you are not from here."
        },
        {
          "text": "“Bed's a shilling, ale's a penny, and if you are after the leech-men they drink at the camp.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "thorn_orin_none",
          "text": "Is there anybody living out on the hummocks?",
          "requires": {
            "without": {
              "lore": [
                "thorn_hermit_none"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
