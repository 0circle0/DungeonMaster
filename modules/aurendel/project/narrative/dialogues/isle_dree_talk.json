                    6
                  ]
                }
              ]
            },
            "onSuccess": "isle_dree_quiet_told",
            "onFailure": "isle_dree_quiet_wont"
          }
        },
        {
          "id": "isle_dree_warm",
          "text": "There is ice on everything here and none on the Bank sand.",
          "requires": {
            "without": {
              "lore": [
                "isle_terns_warm"
              ]
