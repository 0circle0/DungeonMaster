            "onFailure": "isle_dree_warm_wont"
          }
        },
        {
          "id": "greet_leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "isle_dree_quiet_told",
      "says": [
        {
          "text": "“Nothing.” She says it and then makes sure you have got it. “Forty thousand birds on the Bank, and you can hear them here on a still night, and there is a strip in the middle of it that is *silent*. You can hear the shape of the silence. It has a hundred yards of edges.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "isle_terns_quiet"
          }
        }
      ],
      "options": [
        {
          "id": "isle_dree_quiet_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "isle_dree_quiet_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_salvors",
            "amount": -1
          }
        }
      ],
