{
  "id": "isle_dree_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A low room with the window shuttered against spray and a fire that smells of driftwood."
        },
        {
          "text": "“Bed, ale, or the boat times. The boat times are a lie, mind, they come when they come.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "isle_dree_quiet",
          "text": "You hear the Bank from here. What does the cut sound like?",
          "requires": {
            "without": {
              "lore": [
                "isle_terns_quiet"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
