      ],
      "redirectWhen": []
    },
    {
      "id": "skarn_bel_count_told",
      "says": [
        {
          "text": "“Nine hundred and one.” Instantly. Then, watching your face: “The lintel says nine hundred. It has said nine hundred for six hundred years and the hold does not make that kind of mistake.” Bel shoulders the broom. “Four of us have counted. We all get nine hundred and one. We have never worked out which one is the extra.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "skarn_stair_count"
          }
        }
      ],
      "options": [
        {
          "id": "skarn_bel_count_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "skarn_bel_count_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
