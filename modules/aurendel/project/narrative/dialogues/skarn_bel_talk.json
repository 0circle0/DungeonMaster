    {
      "id": "skarn_bel_swept_told",
      "says": [
        {
          "text": "“Nobody.” Bel says it without any bitterness, which is the unsettling part. “The hold pays the railmen, the lampmen and the gate. Not the sweeping.” A shrug. “My great-grandfather started coming up because it wanted doing. It has never wanted doing. It is clean when I get there, every day, and I sweep it anyway.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "skarn_stair_swept"
          }
        }
      ],
      "options": [
        {
          "id": "skarn_bel_swept_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "skarn_bel_swept_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "karn_dolur",
            "amount": -1
          }
        }
      ],
      "options": [
        {
          "id": "skarn_bel_swept_drop",
          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
