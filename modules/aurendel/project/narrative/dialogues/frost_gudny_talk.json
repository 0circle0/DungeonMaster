                      "div": [
                        {
                          "ref": "reputation.the_ice_moot",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "frost_gudny_cut_told",
            "onFailure": "frost_gudny_cut_wont"
          }
        },
        {
          "id": "frost_gudny_moved",
          "text": "Somebody said the Landing used to stand further in.",
          "requires": {
            "without": {
              "lore": [
                "frost_blue_moved"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                13,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_ice_moot",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "frost_gudny_moved_told",
            "onFailure": "frost_gudny_moved_wont"
          }
        },
        {
          "id": "greet_leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_gudny_calving_told",
      "says": [
        {
          "text": "“No.” She straightens up. “And they used to — I worked it. Eleven years since one came inside. They still come to the shore either side of it, mind, which is the part that keeps me up. It is not the shore they are avoiding.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "frost_blue_calving"
          }
        }
      ],
      "options": [
        {
          "id": "frost_gudny_calving_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_gudny_calving_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_ice_moot",
            "amount": -1
          }
        }
      ],
      "options": [
        {
          "id": "frost_gudny_calving_drop",
          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_gudny_cut_told",
      "says": [
        {
          "text": "“Not a flensing iron.” She holds hers up. “This chatters. Every blade chatters, that is what bone does to a blade. Those went through in one and the edge is clean.” She looks at it a moment. “Nothing I have ever been sold does that.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "frost_strand_cut"
          }
        }
      ],
      "options": [
        {
