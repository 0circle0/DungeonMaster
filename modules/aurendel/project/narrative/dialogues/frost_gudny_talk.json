{
  "id": "frost_gudny_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Elbow-deep in a flensing trough, and cheerful about it in a way that suggests she has been doing it long enough to have stopped noticing."
        },
        {
          "text": "“Mind the deck, it's slick the whole length. Twenty-two seasons and I still go over on it.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "frost_gudny_calving",
          "text": "Do the whales still calve inside the face?",
          "requires": {
            "without": {
              "lore": [
                "frost_blue_calving"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                10,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_ice_moot",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "frost_gudny_calving_told",
            "onFailure": "frost_gudny_calving_wont"
          }
        },
        {
          "id": "frost_gudny_cut",
          "text": "Half the skulls on the Strand are cut. What cuts like that?",
          "requires": {
            "without": {
              "lore": [
                "frost_strand_cut"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
