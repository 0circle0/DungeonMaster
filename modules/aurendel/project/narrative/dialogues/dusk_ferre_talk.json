{
  "id": "dusk_ferre_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A low taproom with everything in it damp, a fire that is winning, and a landlady who has already put a mat down for you."
        },
        {
          "text": "“Boots by the fire. Both roads meet here, so I hear both.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "dusk_ferre_width",
          "text": "The Greenway. Who cut it?",
          "requires": {
            "without": {
              "lore": [
