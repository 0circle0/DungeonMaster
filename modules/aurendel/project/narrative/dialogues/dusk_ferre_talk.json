          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "dusk_ferre_night_told",
      "says": [
        {
          "text": "“No.” Flat, and she does not soften it. “The deer go up it and down it. They will cross the turnpike, the coast road and my yard, and they will not step over the Greenway after dark.” She looks at the fire. “I have had drovers in here who lost a night going round rather than over, and they were not men who lose nights.”"
        }
      ],
