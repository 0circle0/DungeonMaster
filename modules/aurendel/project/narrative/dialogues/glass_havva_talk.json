{
  "id": "glass_havva_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A house built against the lip of a hole the size of a market. She is oiling a key that has nothing to open."
        },
        {
          "text": "“Keeper of the Cistern,” she says, before you ask. “There has been no water in it since my great-grandmother. There is still a keeper.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "glass_havva_cut",
          "text": "The cistern — was it built or cut?",
          "requires": {
            "without": {
              "lore": [
                "glass_cistern_cut"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "insight",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_water_wardens",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "glass_havva_cut_told",
            "onFailure": "glass_havva_cut_wont"
          }
        },
        {
          "id": "glass_havva_feed",
          "text": "Where does the water come in?",
          "requires": {
            "without": {
              "lore": [
                "glass_cistern_feed"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
