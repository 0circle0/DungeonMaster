      ],
      "redirectWhen": []
    },
    {
      "id": "ember_esk_board_gave",
      "says": [
        {
          "text": "He lifts it off the pegs and looks at the wall behind it, which is clean where the board was. “Bring it back,” he says. “Or do not, if what you find means there is no point.”"
        }
      ],
      "onEnter": [
        {
          "grantItem": {
            "target": {
              "ref": "actor.id"
            },
            "item": "readers_rhythm",
            "quantity": 1
          }
        },
        {
          "setFlag": {
            "flag": "given:readers_rhythm",
            "value": true
          }
        }
      ],
      "options": [
        {
          "id": "ember_esk_board_thanks",
          "text": "Thank you.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "ember_esk_board_kept",
      "says": [
        {
          "text": "“No. It is forty years and it is one board.”"
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_vent_readers",
            "amount": -2
          }
        }
      ],
      "options": [
        {
          "id": "ember_esk_board_leave",
          "text": "Then no.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "ember_esk_cold",
      "says": [
        {
          "text": "He takes the board off the wall and puts it face to it."
        }
