{
  "id": "ember_esk_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A cottage with a soot-marked board the size of a door on the wall, and a man who has clearly been waiting for somebody to ask about it."
        },
        {
          "text": "“Reader,” he says, of himself, without much conviction. “Retired. Nobody reads the tube.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "ember_esk_wrong",
          "text": "Where does that tube actually go?",
          "requires": {
            "without": {
              "lore": [
                "ember_warm_wrong"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "insight",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_vent_readers",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "ember_esk_wrong_told",
            "onFailure": "ember_esk_wrong_wont"
          }
        },
        {
          "id": "ember_esk_breath",
          "text": "You have been marking its breathing.",
          "requires": {
            "without": {
              "lore": [
                "ember_warm_breath"
