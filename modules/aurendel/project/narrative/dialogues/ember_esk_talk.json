                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "ember_esk_breath_told",
            "onFailure": "ember_esk_breath_wont"
          }
        },
        {
          "id": "ember_esk_older",
          "text": "Is there anything in there that is not rock?",
          "requires": {
            "without": {
              "lore": [
                "ember_warm_older"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
