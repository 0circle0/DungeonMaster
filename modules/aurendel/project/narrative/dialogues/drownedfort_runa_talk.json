{
  "id": "drownedfort_runa_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "The hulks are eleven dead ships moored together into a street, and Runa's is the one in the middle with the list nailed inside the door. \"You'll have come about the fort. Everybody who comes here on purpose has.\""
        }
      ],
      "options": [
        {
          "id": "the_list",
          "text": "What's the list on the door?",
          "effects": [
            {
              "emit": {
                "event": "startQuest",
                "data": {
                  "quest": "drownedfort_four_crews"
                }
              }
            }
          ],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "goto": "four_crews",
          "requires": {
            "quests": [
              {
                "quest": "drownedfort_four_crews",
                "status": "unstarted"
              }
            ],
            "description": "two of the three ward-keys",
            "anyOf": [
              {
                "items": [
                  {
                    "item": "grown_key"
                  },
                  {
                    "item": "cast_key"
                  }
                ]
              },
              {
                "items": [
                  {
                    "item": "grown_key"
                  },
                  {
                    "item": "glass_key"
                  }
                ]
              },
              {
                "items": [
                  {
                    "item": "cast_key"
                  },
                  {
                    "item": "glass_key"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "why_not",
          "text": "Why has nobody salvaged it?",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "goto": "why_not"
        },
        {
          "id": "leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "onEnter": [],
      "redirectWhen": [
