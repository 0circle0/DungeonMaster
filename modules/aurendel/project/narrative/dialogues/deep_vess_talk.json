                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "deep_vess_reading_told",
            "onFailure": "deep_vess_reading_wont"
          }
        },
        {
          "id": "deep_vess_out",
          "text": "Are any of them out?",
          "requires": {
            "without": {
              "lore": [
                "deep_lamps_out"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
