{
  "id": "deep_vess_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A woman walking a lit road with a pole she has never once used, checking lamps that have not needed checking in four hundred years."
        },
        {
          "text": "“Lamp-keeper,” she says, and shrugs at the obvious. “Somebody has the office. It may as well be somebody who walks it.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "deep_vess_lit",
          "text": "Who oils these?",
          "requires": {
            "without": {
              "lore": [
                "deep_lamps_lit"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                11,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_wayfinders",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "deep_vess_lit_told",
            "onFailure": "deep_vess_lit_wont"
          }
        },
        {
          "id": "deep_vess_reading",
          "text": "Do they light the road evenly?",
          "requires": {
            "without": {
              "lore": [
                "deep_lamps_reading"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
