                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "deep_vess_out_told",
            "onFailure": "deep_vess_out_wont"
          }
        },
        {
          "id": "greet_leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "deep_vess_lit_told",
      "says": [
        {
          "text": "“Nobody.” She is cheerful about it in a way that takes a moment to land. “Not in four hundred years. There is no oil in them — I have had one down. There is no wick. They are lit.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "deep_lamps_lit"
          }
        }
      ],
      "options": [
        {
          "id": "deep_vess_lit_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "deep_vess_lit_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_wayfinders",
            "amount": -1
          }
        }
      ],
      "options": [
        {
          "id": "deep_vess_lit_drop",
          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "deep_vess_reading_told",
      "says": [
        {
          "text": "“No, and that is the thing I would tell somebody if anybody asked.” She stops walking. “Stand in the dark *between* two of them and look at the floor. There are marks. Under a lamp you cannot see them at all.”"
        }
      ],
      "onEnter": [
