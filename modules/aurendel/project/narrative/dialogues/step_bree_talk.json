                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "step_bree_width_told",
            "onFailure": "step_bree_width_wont"
          }
        },
        {
          "id": "step_bree_warm",
          "text": "The water at the Last Water.",
          "requires": {
            "without": {
              "lore": [
                "step_water_warm"
              ]
