{
  "id": "step_bree_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A camp in the lee of a bank a quarter of a mile from the other bank, and a fire in a ring of stones that is not this year's ring."
        },
        {
          "text": "“There is room. There has been room here for nine hundred years.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "step_bree_width",
          "text": "This bed is very wide for the water that comes down it.",
          "requires": {
            "without": {
              "lore": [
                "step_bank_width"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "insight",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
