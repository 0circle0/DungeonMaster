            "onFailure": "thorn_pell_facing_wont"
          }
        },
        {
          "id": "thorn_pell_post",
          "text": "You took the post. I want it.",
          "requires": {
            "without": {
              "items": [
                "hermits_tally"
              ],
              "flags": [
                {
                  "flag": "given:hermits_tally"
                }
