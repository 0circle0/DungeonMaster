  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Mud to the chest and cheerful about it, on a hummock barely big enough for the both of you."
        },
        {
          "text": "“Do not follow me,” Pell says. “Not being rude. You will go in.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "thorn_pell_tally",
          "text": "The hut on the far hummock.",
