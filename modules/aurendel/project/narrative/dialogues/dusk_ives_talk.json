  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Sacks by the hundredweight, a set of scales worn to a shine, and a man who has just told somebody their charcoal is damp."
        },
        {
          "text": "“By the sack or by the load. Damp is half price and I will know.”"
        }
      ],
      "onEnter": [],
      "options": [
