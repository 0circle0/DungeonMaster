    {
      "id": "dusk_ives_cuttings_told",
      "says": [
        {
          "text": "“Struck.” Ives is definite. “Every one of them off the same tree — you can see it in the leaf, they are all the same leaf, and oak is not shy about being different.” He weighs something. “I have looked for the mother tree for thirty years. It is not on the road and it is not off it either, and I have been most of the way to Elderhollow looking.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "dusk_miles_cuttings"
          }
        }
      ],
      "options": [
        {
          "id": "dusk_ives_cuttings_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "dusk_ives_cuttings_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
