          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "frost_vigdis_ribs_told",
      "says": [
        {
          "text": "“I sleep with my back to it.” She says it flatly, without any appetite for the joke. “From out here it is a whale. Go and stand inside and count the uprights, and then tell me what whale that is.”"
        }
      ],
      "onEnter": [
