    {
      "id": "deep_hral_bottom_told",
      "says": [
        {
          "text": "“No.” He shifts the frame. “Guild drops a light every year on the anniversary. Four hundred lights. I have dropped a few of my own out of curiosity and I have stopped, because you keep watching, and there is a point where you notice you are still watching.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "deep_bridge_bottom"
          }
        }
      ],
      "options": [
        {
          "id": "deep_hral_bottom_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "deep_hral_bottom_wont",
      "says": [
