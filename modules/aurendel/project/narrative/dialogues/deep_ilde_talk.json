{
  "id": "deep_ilde_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A crossing over the Sunless River, a lamp on a tripod, and a woman scribing onto brass with the river going past under her."
        },
        {
          "text": "“Do not stand in the light. I am taking an angle off the far bank.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "deep_ilde_shaft",
          "text": "The shaft above the Weeping Vault.",
          "requires": {
            "without": {
              "lore": [
                "deep_vault_shaft"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                17,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_wayfinders",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "deep_ilde_shaft_told",
            "onFailure": "deep_ilde_shaft_wont"
          }
        },
        {
          "id": "deep_ilde_warm",
          "text": "The columns weep warm.",
          "requires": {
