            "value": true
          }
        }
      ],
      "options": [
        {
          "id": "ember_tenn_core_thanks",
          "text": "Thank you.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
