    {
      "id": "ember_tenn_core_gave",
      "says": [
        {
          "text": "He hands it over end-first, like a tool. “Count them yourself. I have counted them eleven times and I would like to be wrong.”"
        }
      ],
      "onEnter": [
        {
          "grantItem": {
            "target": {
              "ref": "actor.id"
            },
            "item": "burners_core",
            "quantity": 1
