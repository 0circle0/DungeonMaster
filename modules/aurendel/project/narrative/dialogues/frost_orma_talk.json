    {
      "id": "greet",
      "says": [
        {
          "text": "A chapel with room for forty and nobody in it, in a town that buries at sea."
        },
        {
          "text": "“You will be the first this month,” she says, without reproach. “Sit if you like. Nobody will mind.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "frost_orma_inland",
          "text": "The skulls on the Strand. Have you looked at how they lie?",
