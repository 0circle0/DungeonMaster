{
  "id": "moor_ivy_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "Peat by the load, tallow, rope, and a slate with the parish's account on it in a hand that has clearly added it up twice."
        },
        {
          "text": "“Load, half load, or the parish's account. It is usually the parish's account.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "moor_ivy_fuel",
          "text": "How much peat does the parish buy for that fire?",
          "requires": {
            "without": {
              "lore": [
                "moor_fire_fuel"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "craft",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_library",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "moor_ivy_fuel_told",
            "onFailure": "moor_ivy_fuel_wont"
          }
        },
        {
          "id": "moor_ivy_draught",
          "text": "The holes under the scarp.",
          "requires": {
            "without": {
              "lore": [
                "moor_shoot_draught"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
