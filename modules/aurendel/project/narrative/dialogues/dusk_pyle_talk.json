                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "dusk_pyle_sunken_told",
            "onFailure": "dusk_pyle_sunken_wont"
          }
        },
        {
          "id": "dusk_pyle_book",
          "text": "The mile book. Let me take it.",
          "requires": {
            "without": {
              "items": [
                "mile_book"
              ],
              "flags": [
                {
                  "flag": "given:mile_book"
                }
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                13,
                {
                  "clamp": [
