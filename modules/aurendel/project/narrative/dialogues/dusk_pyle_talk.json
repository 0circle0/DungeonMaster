{
  "id": "dusk_pyle_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A stage house on a straight road, four horses out and four in, and a fare slate being rewritten faster than it can be read."
        },
        {
          "text": "“Bed, bait, or the next coach. In that order of likelihood.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "dusk_pyle_count",
          "text": "How long is the Moot Road?",
          "requires": {
            "without": {
              "lore": [
                "dusk_miles_count"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_keepers",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "dusk_pyle_count_told",
            "onFailure": "dusk_pyle_count_wont"
          }
        },
        {
          "id": "dusk_pyle_sunken",
          "text": "The oaks. Is there anything out by them?",
          "requires": {
            "without": {
              "lore": [
                "dusk_miles_sunken"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
