{
  "id": "skarn_orn_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A cottage with one window facing the road and a lamp burning in it at an hour that does not need a lamp."
        },
        {
          "text": "“Road is open. If you have come to ask, it is open.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "skarn_orn_open",
          "text": "Has the bell ever rung on an open road?",
          "requires": {
            "without": {
              "lore": [
                "skarn_bell_open"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                15,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.karn_dolur",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "skarn_orn_open_told",
            "onFailure": "skarn_orn_open_wont"
          }
        },
        {
          "id": "skarn_orn_rope",
          "text": "The rope.",
          "requires": {
