                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "skarn_orn_rope_told",
            "onFailure": "skarn_orn_rope_wont"
          }
        },
        {
          "id": "skarn_orn_book",
          "text": "The watch book. The eleven nights.",
          "requires": {
            "without": {
              "items": [
                "watch_book"
              ],
              "flags": [
                {
                  "flag": "given:watch_book"
                }
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                12,
                {
                  "clamp": [
                    {
                      "div": [
