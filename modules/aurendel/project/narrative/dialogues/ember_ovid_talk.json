{
  "id": "ember_ovid_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A camp at the edge of a mile of black glass, and a man dressing a blade with his back to all of it."
        },
        {
          "text": "“Obsidian by the pound, and I will not cut to order. Say what you want and be quick, the light goes off the sheet at noon.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "ember_ovid_stair",
          "text": "The stair into the sheet.",
          "requires": {
            "without": {
              "lore": [
                "ember_sheet_stair"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "insight",
            "difficulty": {
              "sub": [
                14,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_vent_readers",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
