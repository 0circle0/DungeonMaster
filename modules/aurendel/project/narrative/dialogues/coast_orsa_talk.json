            "onFailure": "coast_orsa_pond_wont"
          }
        },
        {
          "id": "greet_leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "coast_orsa_correct_told",
      "says": [
        {
          "text": "“Two points to starboard.” Immediately, without thinking. Then she hears herself. “Everybody does. My father did. I have never asked him what for and he is dead now.” She sits back on her heels. “There is nothing there to clear. I have sounded it. There is nothing there.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "coast_watch_correct"
          }
        }
      ],
      "options": [
        {
          "id": "coast_orsa_correct_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "coast_orsa_correct_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_salvors",
            "amount": -1
          }
        }
      ],
      "options": [
