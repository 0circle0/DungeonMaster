                    6
                  ]
                }
              ]
            },
            "onSuccess": "kings_hob_stone_told",
            "onFailure": "kings_hob_stone_wont"
          }
        },
        {
          "id": "greet_leave",
          "text": "Nothing.",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "kings_hob_two_told",
      "says": [
        {
          "text": "“Two.” He puts a sett down. “The warrant is for one. The tallies are for one. There are two, and I have laid road out of that quarry for nineteen years and I would like somebody to explain it who is not a clerk.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "kings_quarry_two"
          }
        }
      ],
      "options": [
        {
          "id": "kings_hob_two_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "kings_hob_two_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
            "faction": "the_crown",
            "amount": -1
          }
        }
      ],
      "options": [
        {
