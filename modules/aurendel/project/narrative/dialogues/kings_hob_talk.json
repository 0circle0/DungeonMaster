{
  "id": "kings_hob_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A forge yard with a road mason's kit against the wall and a man sorting setts by size."
        },
        {
          "text": "“Roadwork. If the road did it to your cart, take it up with the Crown, not me.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "kings_hob_two",
          "text": "How many faces is that quarry worked from?",
          "requires": {
            "without": {
              "lore": [
                "kings_quarry_two"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
