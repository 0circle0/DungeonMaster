                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "kings_hob_two_told",
            "onFailure": "kings_hob_two_wont"
          }
        },
        {
          "id": "kings_hob_stone",
          "text": "Is the stone the same off both?",
          "requires": {
            "without": {
              "lore": [
                "kings_quarry_stone"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
