{
  "id": "glass_taj_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A room of tally-boards, one per well, each with a number chalked on it and a smaller number under that."
        },
        {
          "text": "“Every well in the city, to the cup,” he says, with the flat pride of a man who has never once been thanked for it.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "glass_taj_metered",
          "text": "Is every well on those boards?",
          "requires": {
            "without": {
              "lore": [
                "glass_bath_metered"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
