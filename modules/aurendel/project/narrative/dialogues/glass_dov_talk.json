    {
      "id": "greet",
      "says": [
        {
          "text": "A cellar under the Green Room, cool the way a cellar should be except along one wall."
        },
        {
          "text": "“Mind the step. And mind the west wall, it's warm and it stains your coat.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "glass_dov_warm",
          "text": "Why is that wall warm?",
          "requires": {
