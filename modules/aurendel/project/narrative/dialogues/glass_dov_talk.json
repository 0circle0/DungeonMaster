    {
      "id": "glass_dov_warm_told",
      "says": [
        {
          "text": "“Bath's behind it.” He says it like a man discussing plumbing. Then, less like that: “It's warm all year. Nothing in the Glasslands is warm — the desert's cold at night, everything's cold at night. Warm water means a fire under it, and there's no fire under my cellar.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "glass_bath_warm"
          }
        }
      ],
      "options": [
        {
          "id": "glass_dov_warm_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "glass_dov_warm_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
