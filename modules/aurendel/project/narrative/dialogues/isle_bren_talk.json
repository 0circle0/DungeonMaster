                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "isle_bren_shut_told",
            "onFailure": "isle_bren_shut_wont"
          }
        },
        {
          "id": "isle_bren_held",
          "text": "You went under the marker wreck.",
          "requires": {
            "without": {
              "lore": [
                "isle_marker_held"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
