{
  "id": "isle_bren_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A salvors' camp on a shingle spit, gear drying on every line, and a big man sitting where he can see the reef."
        },
        {
          "text": "“Camp's the Salvors'. If you are here to dive, you are not.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "isle_bren_nothing",
          "text": "What was she fighting?",
          "requires": {
            "without": {
              "lore": [
                "isle_wreck_nothing"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                13,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_salvors",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "isle_bren_nothing_told",
            "onFailure": "isle_bren_nothing_wont"
          }
        },
        {
          "id": "isle_bren_shut",
          "text": "Her hatches.",
          "requires": {
            "without": {
              "lore": [
                "isle_wreck_shut"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
