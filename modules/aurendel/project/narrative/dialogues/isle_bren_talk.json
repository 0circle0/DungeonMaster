            "onFailure": "isle_bren_held_wont"
          }
        },
        {
          "id": "isle_bren_plate",
          "text": "The plate off the capstan. The one with the line on it.",
          "requires": {
            "without": {
              "items": [
                "capstan_plate"
              ],
              "flags": [
                {
                  "flag": "given:capstan_plate"
                }
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
