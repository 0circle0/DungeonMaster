{
  "id": "frost_saeun_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "She is sitting on a hauled-up boat at the end of the Landing with a bone stick across her knees, marking it. She does not stop."
        },
        {
          "text": "“Making tonight,” she says, before you have said anything. “You can hear it if you stop walking.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "frost_saeun_note",
          "text": "What is it you are actually listening for out there?",
          "requires": {
            "without": {
              "lore": [
                "frost_blue_note"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "insight",
            "difficulty": {
              "sub": [
                13,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_ice_moot",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "frost_saeun_note_told",
            "onFailure": "frost_saeun_note_wont"
          }
        },
        {
          "id": "frost_saeun_making",
          "text": "Does it sound every night?",
          "requires": {
            "without": {
              "lore": [
                "frost_blue_making"
