      "id": "greet",
      "says": [
        {
          "text": "A lighter tied at the Long Wharf and a man coiling rope on it who has clearly done this ten thousand times."
        },
        {
          "text": "“Cargo's by the ton and I do not take passengers past the watergate.”"
        }
      ],
      "onEnter": [],
      "options": [
