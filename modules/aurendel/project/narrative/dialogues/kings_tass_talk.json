    {
      "id": "kings_tass_air_told",
      "says": [
        {
          "text": "“All year.” He does not stop coiling. “Warm, and warmer than the river, which the river should not permit. Twenty years I have gone past it four times a day. Winter, summer, flood — same warm air.”"
        }
      ],
      "onEnter": [
        {
          "learnLore": {
            "entry": "kings_under_air"
          }
        }
      ],
      "options": [
        {
          "id": "kings_tass_air_on",
          "text": "Go on.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "kings_tass_air_wont",
      "says": [
        {
          "text": "“I've said all I mean to,” they say, and go back to what they were doing."
        }
      ],
      "onEnter": [
        {
          "adjustReputation": {
