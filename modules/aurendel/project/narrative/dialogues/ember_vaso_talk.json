{
  "id": "ember_vaso_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A taproom warm from the floor up, which is the wrong direction for a room to be warm in."
        },
        {
          "text": "“Mind the flags, they're hot at the back. Ale's cold, at least.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "ember_vaso_never",
          "text": "Has this floor ever been cold?",
          "requires": {
            "without": {
              "lore": [
                "ember_warm_never"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
