      "says": [
        {
          "text": "Rope by the fathom, tar by the barrel, lamp oil, and a wall of charts with three of them turned face-in."
        },
        {
          "text": "“Rope, tar, oil, glass. Charts if you promise not to sue me.”"
        }
      ],
