{
  "id": "coast_tibb_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "The last field before four hundred feet of nothing, and an old farmer leaning on a gate looking inland rather than out."
        },
        {
          "text": "“I have looked at that hill for sixty years. Go on, then.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "coast_tibb_lines",
          "text": "You have looked at it for sixty years. What is it?",
          "requires": {
            "without": {
              "lore": [
                "coast_horse_lines"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "insight",
            "difficulty": {
              "sub": [
                11,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_salvors",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "coast_tibb_lines_told",
            "onFailure": "coast_tibb_lines_wont"
          }
        },
        {
          "id": "coast_tibb_ring",
          "text": "The birds on the head. Is there anywhere they don't nest?",
          "requires": {
            "without": {
              "lore": [
                "coast_watch_ring"
              ]
            }
