          "text": "Leave it.",
          "goto": "greet",
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": ""
        }
      ],
      "redirectWhen": []
    },
    {
      "id": "coast_tibb_paid_told",
      "says": [
        {
          "text": "“In coin, into the box, every year.” Tibb has clearly thought about this. “Now a fee is paid by the owner. So somebody owns it, and has for two hundred years, and has never once come and collected the animal they are paying for.”"
        }
      ],
      "onEnter": [
