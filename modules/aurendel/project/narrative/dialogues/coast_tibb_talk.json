                        {
                          "ref": "reputation.the_salvors",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "coast_tibb_ring_told",
            "onFailure": "coast_tibb_ring_wont"
          }
        },
        {
          "id": "coast_tibb_paid",
          "text": "Somebody pays the October fee at Cobbleway.",
          "requires": {
            "without": {
              "lore": [
                "coast_yard_paid"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
