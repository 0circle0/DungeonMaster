{
  "id": "step_ondir_talk",
  "start": "greet",
  "nodes": [
    {
      "id": "greet",
      "says": [
        {
          "text": "A stone trough, a rope, and somebody sitting where they can see both the water and the road to it."
        },
        {
          "text": "“Drink what you need. Fill what you carry. Do not wash in it.”"
        }
      ],
      "onEnter": [],
      "options": [
        {
          "id": "step_ondir_never",
          "text": "Has the spring ever failed?",
          "requires": {
            "without": {
              "lore": [
                "step_water_never"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
          "lockedHint": "",
          "check": {
            "skill": "persuasion",
            "difficulty": {
              "sub": [
                13,
                {
                  "clamp": [
                    {
                      "div": [
                        {
                          "ref": "reputation.the_horse_lords",
                          "else": 0
                        },
                        5
                      ]
                    },
                    -6,
                    6
                  ]
                }
              ]
            },
            "onSuccess": "step_ondir_never_told",
            "onFailure": "step_ondir_never_wont"
          }
        },
        {
          "id": "step_ondir_shored",
          "text": "What is the hole beside it?",
          "requires": {
            "without": {
              "lore": [
                "step_water_shored"
              ]
            }
          },
          "effects": [],
          "onceOnly": false,
          "showWhenLocked": false,
