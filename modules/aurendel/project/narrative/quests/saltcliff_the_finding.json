          }
        ],
        "else": [
          {
            "adjustReputation": {
              "faction": "the_countinghouse",
              "amount": 10
            }
          },
          {
            "adjustReputation": {
              "faction": "the_salvors",
              "amount": 20
            }
          },
          {
            "adjustReputation": {
              "faction": "the_crown",
              "amount": 8
            }
          },
          {
            "setFlag": {
              "flag": "saltcliff_corrected",
              "value": true
            }
          }
        ]
      }
    }
