        ],
        "else": [
          {
            "adjustReputation": {
              "faction": "the_salvors",
              "amount": 10
            }
          },
          {
            "adjustReputation": {
              "faction": "the_keepers",
              "amount": 18
            }
          },
          {
            "adjustReputation": {
              "faction": "karn_dolur",
              "amount": 10
            }
          },
          {
            "setFlag": {
              "flag": "drownedfort_shut",
              "value": true
            }
          }
        ]
      }
    }
