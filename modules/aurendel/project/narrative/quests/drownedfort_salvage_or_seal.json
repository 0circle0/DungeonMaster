    "quests": [
      {
        "quest": "drownedfort_the_battery",
        "status": "complete"
      }
    ]
  },
  "onComplete": [
    {
      "if": {
        "when": {
          "test": {
            "ref": "flags.drownedfort_salvaged"
          }
        },
        "then": [
          {
            "emit": {
              "event": "deed",
              "data": {
