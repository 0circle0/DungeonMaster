{
  "id": "drownedfort_salvage_or_seal",
  "name": "Salvage It or Seal It",
  "description": "Four hundred years of a fort nobody has been into, dry, with its armoury intact — and a chimney at the far end of it that goes somewhere the Isles would rather not have a road to.",
  "autoStart": false,
  "ordered": false,
  "tags": [
    "side",
    "act3",
    "drownedfort",
    "sundered_isles"
  ],
  "objectives": [
    {
      "id": "salvage_it",
      "description": "Open the fort to the salvors.",
      "kind": "custom",
      "count": 1,
      "hidden": false,
      "optional": true,
      "when": {
        "test": {
          "ref": "flags.drownedfort_salvaged"
        }
      }
    },
    {
      "id": "seal_it",
      "description": "Seal the chimney and leave the fort.",
      "kind": "custom",
      "count": 1,
      "hidden": false,
      "optional": true,
      "when": {
        "test": {
          "ref": "flags.drownedfort_sealed"
        }
      }
    },
    {
      "id": "settled",
      "description": "Settle what happens to the fort.",
      "kind": "custom",
      "count": 1,
      "hidden": false,
      "optional": false,
      "when": {
        "any": [
          {
            "test": {
              "ref": "flags.drownedfort_salvaged"
            }
          },
          {
            "test": {
              "ref": "flags.drownedfort_sealed"
            }
          }
        ]
      }
    }
  ],
  "stages": [],
  "unlocks": [],
  "rewards": {
    "xp": 135,
