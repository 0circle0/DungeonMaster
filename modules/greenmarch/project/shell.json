  "narrative": {
    "memory": {
      "mode": "hybrid",
      "forgetting": {
        "curve": "exponential",
        "halfLifeDays": 45,
        "floor": 0.05,
        "reinforceOnRecall": 0.3,
        "neverForget": [
          "barrow_robbed"
        ]
      },
      "gossip": {
        "enabled": true,
        "spreadPerDay": 0.3,
        "maxHops": 3,
        "hopRetention": 0.7,
        "distortionPerHop": 0.2,
        "requiresTravel": true,
        "crossFactionRate": 0.2,
        "minimumSeverity": 5
      },
      "witness": {
        "radius": 0,
        "requiresLineOfSight": true,
        "deadMenTellNoTales": true,
        "identificationChance": 0.75,
        "disguiseReduction": 0.5,
        "factionAlwaysLearns": false
      },
      "learning": {
        "enabled": true,
        "encountersBeforeAdapting": 3,
        "adaptationStrength": 0.5,
        "sharedWithinFaction": true,
        "minimumIntellect": 6,
        "tracks": [
          "damageTypes",
          "abilities"
        ],
        "forgetAfterDays": 60
      },
      "rules": [
        {
          "id": "vess_never_forgets_theft",
          "name": "Vess never forgets a theft",
          "description": "The GM pins this one: whatever the simulation decides, Vess learns of a theft and never lets it go.",
          "deedKinds": [
            "theft"
          ],
          "alwaysKnownBy": [
            "vess"
          ],
          "halfLifeDays": 3650
        },
        {
          "id": "barrow_is_quiet",
          "name": "The barrow keeps its own counsel",
          "description": "Nothing living saw it, so opening the barrow spreads only to the things of the fen.",
          "deedKinds": [
            "barrow_robbed"
          ],
          "neverKnownBy": [
            "vess"
          ],
          "spreadPerDay": 0
        }
      ]
    },
