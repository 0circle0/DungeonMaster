{
  "format": 1,
  "id": "greenmarch",
  "version": "0.1.0",
  "engine": "^1.0.0",
  "extends": null,
  "meta": {
    "title": "The Greenmarch",
    "author": "DungeonMaster",
    "description": "A worked example of a complete game flow: biome to area to point of interest, gated progression, encounters with odds, loot limited by what a character has become, a staged quest with dialogue and memory, and creatures that react to each other rather than only to the party.",
    "tags": [
      "demo",
      "fantasy"
    ]
  },
  "rules": {
    "resolution": {
      "checkDice": "1d20",
      "advantageDice": "2d20kh1",
      "disadvantageDice": "2d20kl1",
      "defaultDifficulty": 12,
      "difficulties": {
        "easy": 8,
        "standard": 12,
        "hard": 16,
        "daunting": 20
      }
    },
    "progression": {
      "maxLevel": 10,
      "levels": [
        {
          "level": 1,
          "xpRequired": 0
        },
        {
          "level": 2,
          "xpRequired": 100,
          "grants": [
            {
              "grantItem": {
                "target": {
                  "ref": "actor.id"
                },
                "item": "rope",
                "quantity": 2
              }
            }
          ]
        },
        {
          "level": 3,
          "xpRequired": 300,
          "grants": [
            {
              "setFlag": {
                "flag": "veteran",
                "value": true
              }
            }
          ]
        },
        {
          "level": 4,
          "xpRequired": 600
        },
        {
          "level": 5,
          "xpRequired": 1000
        }
      ],
      "proficiency": {
        "add": [
          2,
          {
            "floor": {
              "div": [
                {
                  "sub": [
                    {
                      "ref": "actor.level"
                    },
                    1
                  ]
                },
                4
              ]
            }
          }
        ]
      }
    },
    "vitalResource": "hp",
    "initiativeStat": "initiative",
    "perception": {
      "defaultStance": "walk",
      "sightSense": "sight",
      "curiosityMinutes": 20
    },
    "defaultSize": "medium",
    "currency": {
      "name": "marks",
      "abbrev": "m"
    },
    "spellcasting": {
      "mode": "slots",
      "maxSpellLevel": 3,
      "slotTable": {
        "1": [
          2
        ],
        "2": [
          3
        ],
        "3": [
          4,
          2
        ]
      },
      "saveDifficulty": {
        "add": [
          8,
          {
            "ref": "actor.castingMod"
          }
        ]
      },
      "attackBonus": {
        "add": [
          2,
          {
            "ref": "actor.castingMod"
          }
        ]
      },
      "concentration": {
        "enabled": true,
        "savingThrow": "will",
        "difficulty": {
          "max": [
            10,
            {
              "floor": {
                "div": [
                  {
                    "ref": "damage"
                  },
                  2
                ]
              }
            }
          ]
        },
        "maxConcurrent": 1
      },
      "recoverOn": [
        "camp"
      ],
      "ritualCasting": true,
      "componentActionTypes": {
        "verbal": "speak",
        "somatic": "gesture"
      }
    }
  },
